{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodwise.local/contract/model_manifest.schema.json",
  "title": "食刻有数模型产物清单 v2",
  "description": "说明性 schema。权威校验实现为 modeling/foodwise_ml/manifest.py（零第三方依赖，CI 直接执行）。",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_version",
    "model_version",
    "model_kind",
    "source_kind",
    "created_at",
    "model_file",
    "model_sha256",
    "feature_file",
    "feature_sha256",
    "quantiles",
    "calibration",
    "cost_model",
    "metrics",
    "data",
    "limits"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 2 },
    "bundle_version": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "model_kind": { "enum": ["point", "quantile", "calibrated-quantile"] },
    "source_kind": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "model_file": { "type": "string", "minLength": 1, "pattern": "^[^/].*$" },
    "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "feature_file": { "type": "string", "minLength": 1, "pattern": "^[^/].*$" },
    "feature_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "quantiles": {
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
    },
    "calibration": {
      "type": "object",
      "required": ["method", "status", "alpha", "artifact", "artifact_sha256", "picp90"],
      "properties": {
        "method": { "type": ["string", "null"] },
        "status": { "enum": ["uncalibrated", "calibrated", "failed"] },
        "alpha": { "type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "artifact": { "type": ["string", "null"] },
        "artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "picp90": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "calibrated" } }, "required": ["status"] },
          "then": {
            "required": ["method", "alpha", "artifact", "artifact_sha256", "picp90"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "alpha": { "type": "number" },
              "artifact": { "type": "string", "minLength": 1 },
              "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "picp90": { "type": "number" }
            }
          }
        }
      ]
    },
    "cost_model": {
      "type": "object",
      "required": ["source", "defaults"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "defaults": {
          "type": "object",
          "required": ["price", "unit_cost", "discount_price", "shortage_penalty_lambda"],
          "properties": {
            "price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "unit_cost": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "discount_price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "shortage_penalty_lambda": { "type": ["number", "null"], "minimum": 0 }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["mae", "mase", "picp90", "pinaw90", "winkler90", "regret", "evaluated_on"],
      "properties": {
        "mae": { "type": ["number", "null"] },
        "mase": { "type": ["number", "null"] },
        "picp90": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "pinaw90": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "winkler90": { "type": ["number", "null"] },
        "regret": { "type": ["number", "null"] },
        "evaluated_on": { "type": ["string", "null"] }
      }
    },
    "data": {
      "type": "object",
      "required": ["dataset", "rows", "sha256"],
      "properties": {
        "dataset": { "type": "string", "minLength": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    }
  }
}